# Copia este archivo como .env (no se sube a git).

# ---------- API ----------
PORT=4000
# Clave para usar la API como administrador de la plataforma (cabecera X-Admin-Key).
# Elige una larga; vacía = API abierta (solo para desarrollo local).
PLATAFORMA_ADMIN_KEY=
DB_PATH=./plataforma.db

# ---------- Worker ----------
# Credenciales AWS: en local, un perfil del AWS CLI. En la EC2 de la plataforma se usa su rol IAM.
AWS_PROFILE=andres
AWS_REGION=us-east-1

# De dónde saca el worker las plantillas de asistencia-infra:
#   - INFRA_DIR: una carpeta local (útil mientras se desarrollan las plantillas)
#   - si está vacía, clona INFRA_REPO en el tag o rama INFRA_REF
INFRA_DIR=../asistencia-infra
INFRA_REPO=https://github.com/GatoJustiniano/asistencia-infra.git
INFRA_REF=main

# Versión (tag o rama) de asistencia-app que se instala en los tenants nuevos
APP_VERSION=main

# Binarios de los motores (deben estar en el PATH o ser rutas completas)
TERRAFORM_BIN=terraform
TOFU_BIN=tofu

# Segundos que espera el worker a que /api/health de un tenant responda
HEALTH_TIMEOUT_S=600

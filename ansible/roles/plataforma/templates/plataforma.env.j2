# Generado por Ansible (rol plataforma). Contiene la clave de administrador: 0600, solo root
# (systemd lo lee antes de cambiar al usuario del servicio).
PORT={{ plataforma_puerto }}
PLATAFORMA_ADMIN_KEY={{ clave_admin }}
DB_PATH={{ plataforma_datos }}/plataforma.db
TRABAJOS_DIR={{ plataforma_datos }}/trabajos
PLUGIN_CACHE_DIR={{ plataforma_datos }}/plugins
HOME={{ plataforma_datos }}

# Credenciales AWS: el rol IAM de la instancia (sin AWS_PROFILE ni claves)
AWS_REGION={{ region }}

INFRA_DIR=
INFRA_REPO={{ infra_repo }}
INFRA_REF={{ infra_ref }}
APP_VERSION={{ app_version }}
TERRAFORM_BIN=/usr/local/bin/terraform
TOFU_BIN=/usr/local/bin/tofu
HEALTH_TIMEOUT_S=600

GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_URL_PUBLICA=http://{{ ip_publica }}:3000
GRAFANA_TOKEN_SSM={{ ssm_prefijo }}/grafana-token
